# Docker 部署环境变量模板。
# 使用方式：复制本文件为同目录下的 .env（docker compose 会在本目录读取，且已被 .gitignore 忽略），填写后执行：
#   docker compose up -d --build
# 强校验说明：POSTGRES_PASSWORD、JWT_SIGNING_KEY、REFRESH_TOKEN_PEPPER 在 docker-compose.yml 中以
#            ${VAR:?...} 语法强制要求，缺失会直接报错退出，请务必填写为非占位的随机值。
#
# 数据库容器（postgres 服务）凭据，其中 POSTGRES_PASSWORD 为必填：
POSTGRES_DB=youtiao-api
POSTGRES_USER=youtiao
POSTGRES_PASSWORD=

# 应用与数据库：标识运行环境并提供 PostgreSQL 连接地址。非 development 环境会强制校验 JWT_SIGNING_KEY 与 REFRESH_TOKEN_PEPPER 的安全性；DATABASE_URL 供 API、Worker、定时任务及迁移共用，异步连接地址默认自动推导为 asyncpg 驱动。
# 注意：使用 docker compose 部署时 DATABASE_URL 由 compose 依据上面的 POSTGRES_* 自动拼接并注入，此处无需改动。
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/youtiao-api

# 渠道模型：Provider 地址和 API Key 均通过渠道管理接口写入数据库。API Key 仅由 Worker 按冻结的密钥版本读取，禁止写入任务快照、日志和响应。

# JWT 与刷新令牌：JWT_SIGNING_KEY 用于访问令牌的 HS256 签名与验签，ISSUER 与 AUDIENCE 必须在签发和验签时保持一致；REFRESH_TOKEN_PEPPER 用于刷新令牌摘要。两个有效期参数分别限制访问令牌的分钟数和刷新令牌的天数；修改密钥或盐值会使相应既有令牌失效。
JWT_SIGNING_KEY=replace-with-a-long-random-secret
JWT_ISSUER=youtiao-api
JWT_AUDIENCE=youtiao-api-clients
REFRESH_TOKEN_PEPPER=replace-with-a-different-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# 公开访问地址：用于生成成品下载等对外绝对地址；留空时仅返回相对路径。
PUBLIC_BASE_URL=http://localhost:8000

# Redis 仅用于 JWT 会话验证缓存；不可用时认证会回源 PostgreSQL。
AUTH_REDIS_URL=redis://localhost:6379/2
SYSTEM_TASK_SCHEDULER_INTERVAL_SECONDS=30
SYSTEM_TASK_LOCK_TTL_SECONDS=60

# 数据库连接池：同步池和异步池分别控制每个进程的 SQLAlchemy 常驻连接数与额外临时扩容数。
DATABASE_POOL_SIZE=16
DATABASE_MAX_OVERFLOW=4
DATABASE_ASYNC_POOL_SIZE=36
DATABASE_ASYNC_MAX_OVERFLOW=6
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# HTTP 连接池：限制每个 API 进程对上游 Provider 的活跃连接和空闲保活连接数。
HTTP_MAX_CONNECTIONS=32
HTTP_MAX_KEEPALIVE_CONNECTIONS=16

# 视频任务可靠性：从成功提交至上游起，超过该时限的任务将退款并终止；批量大小限制单轮轮询扫描量。
VIDEO_TASK_TIMEOUT_SECONDS=86400
VIDEO_MAINTENANCE_BATCH_SIZE=100
VIDEO_RESULT_STORAGE_DIR=./data/video-results
VIDEO_RESULT_RETENTION_HOURS=12
VIDEO_RESULT_DOWNLOAD_RETRY_SECONDS=300

# 支付宝支付配置保存于数据库 options 表；该密钥由部署环境注入，用于加密应用私钥和支付宝公钥。
# 生成方式（Fernet 密钥）：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_CONFIG_ENCRYPTION_KEY=
# 支付回调对外基础地址，必须是第三方支付平台可访问的公网 HTTPS 地址；此处仅为占位示例。
PAYMENT_CALLBACK_BASE_URL=https://your-public-domain.example.com
