# 后端本地（非容器）运行环境变量示例。
# 使用方式：复制本文件为同目录下的 backend/.env 后按需修改（该 .env 已被 .gitignore 忽略）。
# 说明：仅 DATABASE_URL 为必填项，其余变量都有代码默认值（见 app/core/config.py），此处只列本地开发常用项。
#     若通过 docker compose 部署，请改用 docker/.env.example。

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# 必填：PostgreSQL 连接地址。异步连接地址默认自动推导为 asyncpg 驱动，无需单独配置。
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/youtiao-api

# 认证：development 环境可使用占位值；非 development 环境会强制校验长度与占位符。
JWT_SIGNING_KEY=replace-with-a-long-random-secret
JWT_ISSUER=youtiao-api
JWT_AUDIENCE=youtiao-api-clients
REFRESH_TOKEN_PEPPER=replace-with-a-different-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ALLOW_ORIGINS=[]

# 公开访问地址：用于生成成品下载等对外绝对地址；留空时仅返回相对路径。
PUBLIC_BASE_URL=http://localhost:8000

# Redis 仅用于 JWT 会话验证缓存；不可用时认证会回源 PostgreSQL。
AUTH_REDIS_URL=redis://localhost:6379/2

# 支付（可选，启用支付功能时才需要）：用于加密 options 表中的敏感凭据。
# 生成方式（Fernet 密钥）：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_CONFIG_ENCRYPTION_KEY=
PAYMENT_CALLBACK_BASE_URL=https://your-public-domain.example.com
