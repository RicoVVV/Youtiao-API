# 后端本地（非容器）运行环境变量示例。
# 使用方式：复制本文件为同目录下的 backend/.env 后按需修改（该 .env 已被 .gitignore 忽略）。
# 说明：仅 DATABASE_URL 为必填项，其余变量都有代码默认值（见 app/core/config.py），此处只列本地开发常用项。
#     若通过 docker compose 部署，请改用 docker/.env.example。

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# 必填：PostgreSQL 连接地址。异步连接地址默认自动推导为 asyncpg 驱动，无需单独配置。
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/youtiao-api

# 认证：development 环境可使用占位值；非 development 环境会强制校验长度与占位符。
JWT_SIGNING_KEY=replace-with-a-long-random-secret
JWT_ISSUER=youtiao-api
JWT_AUDIENCE=youtiao-api-clients
REFRESH_TOKEN_PEPPER=replace-with-a-different-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# 公开访问地址：用于生成成品下载等对外绝对地址；留空时仅返回相对路径。
PUBLIC_BASE_URL=http://localhost:8000

# Redis 仅用于 JWT 会话验证缓存；不可用时认证会回源 PostgreSQL。
AUTH_REDIS_URL=redis://localhost:6379/2
SYSTEM_TASK_SCHEDULER_INTERVAL_SECONDS=30
SYSTEM_TASK_LOCK_TTL_SECONDS=60

# 数据库连接池：同步池和异步池分别控制每个进程的 SQLAlchemy 常驻连接数与额外临时扩容数。
# 异步池是 HTTP 并发真正的上限：每个在途请求借出一条连接，容量 = ASYNC_POOL_SIZE + ASYNC_MAX_OVERFLOW；
# 超出后请求等待 POOL_TIMEOUT_SECONDS 仍未取到连接会返回 503（日志关键字：数据库连接池等待超时）。
DATABASE_POOL_SIZE=16
DATABASE_MAX_OVERFLOW=4
DATABASE_ASYNC_POOL_SIZE=36
DATABASE_ASYNC_MAX_OVERFLOW=6
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# HTTP 连接池：限制每个 API 进程对上游 Provider 的活跃连接和空闲保活连接数。
# 并发容量上限 ≈ 进程数 × HTTP_MAX_CONNECTIONS，千级并发需要按副本数估算，并同步放宽容器 nofile。
HTTP_MAX_CONNECTIONS=256
HTTP_MAX_KEEPALIVE_CONNECTIONS=64

# 用量明细：超过该天数的记录只清空响应体（上游响应与公开响应），请求体与计费字段长期保留。
USAGE_RECORD_RESPONSE_RETENTION_DAYS=90

# 视频任务可靠性：从成功提交至上游起，超过该时限的任务将退款并终止；批量大小限制单轮轮询扫描量。
VIDEO_TASK_TIMEOUT_SECONDS=86400
VIDEO_MAINTENANCE_BATCH_SIZE=100

# 视频素材与成品存储：容器部署必须指向持久卷（如 /app/media/video-materials、/app/media/video-results），
# 否则重建容器会丢失进行中任务的素材和保留期内的成品。
VIDEO_MATERIAL_STORAGE_DIR=./data/video-materials
VIDEO_RESULT_STORAGE_DIR=./data/video-results
VIDEO_MATERIAL_RETENTION_HOURS=12
VIDEO_RESULT_RETENTION_HOURS=12
VIDEO_RESULT_DOWNLOAD_RETRY_SECONDS=300

# 视频素材限制：单素材大小、单请求素材数量与总字节、单素材实测时长与图片像素上限。
VIDEO_MATERIAL_DOWNLOAD_TIMEOUT_SECONDS=30
VIDEO_MATERIAL_PROBE_TIMEOUT_SECONDS=60
VIDEO_MATERIAL_MAX_REDIRECTS=3
VIDEO_MATERIAL_MAX_BYTES=209715200
VIDEO_MATERIAL_MAX_COUNT_PER_REQUEST=16
VIDEO_MATERIAL_MAX_TOTAL_BYTES_PER_REQUEST=536870912
VIDEO_MATERIAL_MAX_VIDEO_SECONDS=1200
VIDEO_MATERIAL_MAX_IMAGE_PIXELS=64000000

# 支付（可选，启用支付功能时才需要）：用于加密 options 表中的敏感凭据。
# 生成方式（Fernet 密钥）：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_CONFIG_ENCRYPTION_KEY=
PAYMENT_CALLBACK_BASE_URL=https://your-public-domain.example.com
